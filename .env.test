# Test Environment Configuration
NODE_ENV=test

# Server
PORT=0  # Use random port for tests
HOST=localhost

# Database
DB_DIALECT=mysql
DB_HOST=localhost
DB_PORT=3306
DB_NAME=microhire_test
DB_USER=root
DB_PASSWORD=
DB_POOL_MAX=5
DB_POOL_MIN=0
DB_POOL_ACQUIRE=30000
DB_POOL_IDLE=10000
TEST_DATABASE_URL=mysql://root:@localhost:3306/microhire_test

# JWT
JWT_SECRET=test-secret-key
JWT_REFRESH_SECRET=test-refresh-secret-key
JWT_ACCESS_EXPIRATION_MINUTES=15
JWT_REFRESH_EXPIRATION_DAYS=7

# Redis
REDIS_URL=redis://localhost:6379/1
REDIS_PASSWORD=

# Email (mocked in tests)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=test@example.com
SMTP_PASSWORD=test-password
SMTP_FROM=test@example.com

# File Uploads (mocked in tests)
MAX_FILE_SIZE=5242880  # 5MB
UPLOAD_DIR=uploads/test

# Rate Limiting (relaxed for tests)
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=1000

# Security (relaxed for tests)
CSRF_COOKIE_SECURE=false
CSRF_COOKIE_HTTP_ONLY=true
SESSION_SECRET=test-session-secret

# Feature Flags
ENABLE_2FA=false
ENABLE_EMAIL_VERIFICATION=false
ENABLE_RATE_LIMITING=false

# Logging
LOG_LEVEL=error  # Only show errors in test output
LOG_TO_FILE=false

# Testing
TEST_TIMEOUT=30000  # 30 seconds
